# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Master User ID
# The user ID who will receive the daily good morning message
# To get your user ID: Enable Developer Mode in Discord -> Right-click your profile -> Copy ID
DISCORD_MASTER_ID=your_discord_user_id_here

# Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
